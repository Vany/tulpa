#!/bin/sh
# plutil stand-in for the update.sh harness, for plists whose top-level keys each sit on one line with their
# value, as the harness and install.command write them. Records the call, then:
#   plutil -replace KEY -string VALUE FILE   sets <key>KEY</key><string>VALUE</string>
#   plutil -replace KEY -xml VALUE FILE      sets <key>KEY</key>VALUE
#     (a value replaced, or the key added before the top-level </dict>; values: strings, integers, booleans
#     and flat dicts of booleans)
#   plutil -extract KEY raw -o - FILE        prints a boolean as true or false, a dict's keys one a line, a
#                                            string or an integer as it is; exit 1 when the key is absent
printf 'plutil %s\n' "$*" >>"${STUB_STATE:?}/calls"
value='(<string>[^<]*</string>|<integer>[^<]*</integer>|<true/>|<false/>|<dict>(<key>[^<]*</key>(<true/>|<false/>))*</dict>)'
case ${1:-}/${3:-} in
-replace/-string | -replace/-xml)
	[ $# -eq 5 ] || exit 64
	key=$2 file=$5
	if [ "$3" = -string ]; then new="<string>$4</string>"; else new=$4; fi
	[ -f "$file" ] || exit 1
	if grep -q "<key>$key</key>" "$file"; then
		sed -E "s:<key>$key</key> *$value:<key>$key</key>$new:" "$file" >"$file.stub" || exit 1
	else
		sed "s:</dict></plist>:<key>$key</key>$new</dict></plist>:" "$file" >"$file.stub" || exit 1
	fi
	mv "$file.stub" "$file"
	;;
-extract/raw)
	[ $# -eq 6 ] && [ "$4" = -o ] && [ "$5" = - ] || exit 64
	key=$2 file=$6
	[ -f "$file" ] || exit 1
	found=$(tr -d '\n' <"$file" | sed -E -n "s:.*<key>$key</key> *$value.*:\1:p")
	case $found in
	'')
		printf 'Could not extract value, error: No value at that key path or invalid key path: %s\n' "$key" >&2
		exit 1
		;;
	'<true/>') printf 'true\n' ;;
	'<false/>') printf 'false\n' ;;
	'<dict>'*) printf '%s\n' "$found" | grep -o '<key>[^<]*</key>' | sed 's:</*key>::g' ;;
	*) printf '%s\n' "$found" | sed 's:<[^>]*>::g' ;;
	esac
	;;
*) exit 64 ;;
esac
